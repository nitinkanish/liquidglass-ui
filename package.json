{
  "name": "liquidglass-ui-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "dev": "pnpm --filter @liquidglass/docs dev",
    "build": "pnpm --filter @nkanish/liquidglass-ui build && pnpm --filter @liquidglass/docs build",
    "build:lib": "pnpm --filter @nkanish/liquidglass-ui build",
    "build:docs": "pnpm --filter @liquidglass/docs build",
    "test": "pnpm --filter @nkanish/liquidglass-ui test",
    "test:watch": "pnpm --filter @nkanish/liquidglass-ui test:watch",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium-desktop --project=chromium-mobile",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.9.0",
    "playwright": "^1.65.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
