{
  "name": "@nkanish/liquidglass-ui",
  "version": "0.2.0",
  "description": "Advanced Apple Liquid Glass (iOS 26 / macOS Tahoe) UI component library for React with SVG refraction effects, backdrop blur, and beautiful animations",
  "keywords": [
    "react",
    "liquid glass",
    "glass",
    "glassmorphism",
    "glisse",
    "ui",
    "components",
    "ios",
    "macos",
    "tahoe",
    "backdrop-filter",
    "svg-filter",
    "refraction",
    "apple",
    "design-system",
    "accessibility",
    "typescript",
    "tailwind"
  ],
  "license": "MIT",
  "author": "Nitin Kanish, Debugged Pro",
  "homepage": "https://liquidglass-ui-docs.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitinkanish/liquidglass-ui.git"
  },
  "bugs": {
    "url": "https://github.com/nitinkanish/liquidglass-ui/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/styles.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": {
      "style": "./dist/styles.css",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
